{
	"link-url": {
		"scope": "typst",
		"prefix": ["линк", "link"],
		"body": "#link(\"$1\")[$2] $0",
		"description": "Insert URL link",
	},

	"link-label": {
		"scope": "typst",
		"prefix": ["линк", "link"],
		"body": "#link(<$1>)[$2] $0",
		"description": "Insert <label> link",
	},

	"footnote": {
		"scope": "typst",
		"prefix": ["фуснота", "fusnota", "фн", "fn", "фоотноте", "footnote"],
		"body": "#footnote[$1] $0",
		"description": "Insert a footnote",
	},

	"reference": {
		"scope": "typst",
		"prefix": ["референца", "referenca"],
		"body": "@$1 $0",
		"description": "Insert a reference",
	},

	"quote-inline": {
		"scope": "typst",
		"prefix": ["цитат", "citat", "љуоте", "quote"],
		"body": "#quote(attribution: [$2])[$1] $0",
		"description": "Insert an inline quote with attribution",
	},

	"quote-block": {
		"scope": "typst",
		"prefix": ["цитат", "citat", "љуоте", "quote"],
		"body": [
			"#quote(",
			"\tblock: true,",
			"\tattribution: [$2],",
			")[",
			"\t$1",
			"]",
			"",
			"$0",
		],
		"description": "Insert a block quote with attribution"
	},

	"figure-generic": {
		"scope": "typst",
		"prefix": ["фигура", "figura"],
		"body": [
			"#figure(",
			"\tcaption: [$2],",
			")[",
			"\t$1",
			"]",
			"<$3>",
			"",
			"$0",
		],
		"description": "Insert a generic figure",
	},

	"figure": {
		"scope": "typst",
		"prefix": ["слика", "slika", "фигура", "figura"],
		"body": [
			"#figure(",
			"\tcaption: [$2],",
			")[",
			"\t#image(\"$1\")",
			"]",
			"<$3>",
			"",
			"$0",
		],
		"description": "Insert a figure from an image file",
	},

	"listing": {
		"scope": "typst",
		"prefix": ["листинг", "listing", "код", "kod", "цоде", "code"],
		"body": [
			"#figure(",
			"\tcaption: [$3],",		
			")[",
			"\t```$1",
			"\t\t$2",
			"\t```",
			"]",
			"<$4>",
			"",
			"$0",
		],
		"description": "Insert a code listing from inline code",
	},

	"listing-file": {
		"scope": "typst",
		"prefix": ["листинг", "listing", "код", "kod", "цоде", "code"],
		"body": [
			"#figure(",
			"\tcaption: [$2],",
			")[",
			"\t#raw(read(\"$1\"), lang: \"${1/.*\\.([^.]+)$/$1/}\", block: true)",
			"]",
			"<$3>",
			"",
			"$0",
		],
		"description": "Insert a code listing from a file. The language is automatically detected from the file extension.",
	},

	"table": {
		"scope": "typst",
		"prefix": ["табела", "tabela"],
		"body": [
			"#figure(",
			"\tcaption: [$4],",
			")[",
			"\t#table(",
			"\t\tcolumns: $1,",
			"",
			"\t\ttable.header($2),",
			"\t\t$3",
			"\t)",
			"]",
			"<$5>",
			"",
			"$0",
		],
		"description": "Insert a table",
	},

	"table-csv": {
		"scope": "typst",
		"prefix": ["табела", "tabela", "цсв", "csv"],
		"body": [
			"#figure(",
			"\tcaption: [$2],",
			")[",
			"\t#let data = csv(\"$1\")",
			"",
			"\t#table(",
			"\t\tcolumns: data.at(0).len(),",
			"",
			"\t\ttable.header(..data.at(0)),",
			"\t\t..data.slice(1).flatten(),",
			"\t)",
			"]",
			"<$3>",
			"",
			"$0",
		],
		"description": "Insert a table from a CSV file",
	},

	"table-csv-headless": {
		"scope": "typst",
		"prefix": ["табела", "tabela", "цсв", "csv"],
		"body": [
			"#figure(",
			"\tcaption: [$3],",
			")[",
			"\t#let data = csv(\"$1\")",
			"",
			"\t#table(",
			"\t\tcolumns: data.at(0).len(),",
			"",
			"\t\ttable.header($2),",
			"\t\t..data.flatten(),",
			"\t)",
			"]",
			"<$4>",
			"",
			"$0",
		],
		"description": "Insert a table from a CSV file (without header row)",
	},

	"term": {
		"scope": "typst",
		"prefix": ["термин", "termin"],
		"body": [
			"/ $1: $2",
			"$0",
		],
		"description": "Insert a term with definition",
	},

	"lorem": {
		"scope": "typst",
		"prefix": ["лорем", "lorem"],
		"body": "#lorem(${1:20}) $0",	
		"description": "Insert lorem ipsum text"
	}
} 